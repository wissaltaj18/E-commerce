{% extends 'base.html.twig' %}

{% block title %}Cart - Our Store{% endblock %}

{% block nav_cart %}active{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">🛒 Mon Panier</h1>

    {% if cart is empty %}
        <div class="alert alert-info">
            Votre panier est vide. <a href="{{ path('products') }}">Continuer les achats</a>
        </div>
    {% else %}
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Produit</th>
                    <th>Prix</th>
                    <th>Quantité</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in cart %}
                    <tr>
                        <td>{{ item.name }}</td>
                        <td>{{ item.price }} MAD</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.total }} MAD</td>
                        <td>
                            <a href="{{ path('cart_remove', {'id': item.id}) }}"
                               class="btn btn-danger btn-sm">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Total :</td>
                    <td colspan="2" class="fw-bold text-success">{{ total }} MAD</td>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('cart_clear') }}" class="btn btn-warning">Vider le panier</a>
            <a href="{{ path('products') }}" class="btn btn-outline-secondary">Continuer les achats</a>
        </div>
    {% endif %}
</div>
{% endblock %}
