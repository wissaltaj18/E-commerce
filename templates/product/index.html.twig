{% extends 'base.html.twig' %}

{% block title %}Products - Our Store{% endblock %}

{% block nav_products %}active{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Our Products</h1>

    <form action="{{ path('products') }}" method="get" class="row g-2 mb-4">
        <div class="col-auto flex-grow-1">
            <label for="search-query" class="visually-hidden">Rechercher un produit</label>
            <input type="text" id="search-query" name="q" value="{{ searchQuery|default('') }}"
                   class="form-control" placeholder="Rechercher un produit...">
        </div>
        <div class="col-auto">
            <label for="search-category" class="visually-hidden">Catégorie</label>
            <select id="search-category" name="category" class="form-select">
                <option value="">Toutes les catégories</option>
                {% for category in categories %}
                    <option value="{{ category.id }}"
                        {% if selectedCategory is defined and selectedCategory == category.id %}selected{% endif %}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Rechercher</button>
        </div>
        {% if (searchQuery is defined and searchQuery) or (selectedCategory is defined and selectedCategory) %}
            <div class="col-auto">
                <a href="{{ path('products') }}" class="btn btn-outline-secondary">Réinitialiser</a>
            </div>
        {% endif %}
    </form>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for product in products %}
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset(product.image ?? 'item.png') }}"
                         class="card-img-top" alt="{{ product.name }}"
                         style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        {% if product.category %}
                            <span class="badge bg-secondary mb-2">{{ product.category.name }}</span>
                        {% endif %}
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text text-muted small">{{ product.description }}</p>
                        <p class="card-text fw-bold text-success">{{ product.price }} MAD</p>
                        <a href="{{ path('product_details', {'id': product.id}) }}"
                           class="btn btn-outline-primary">View Details</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>No products found.</p>
        {% endfor %}
    </div>
</div>

<section class="bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">Pourquoi nous choisir ?</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 text-center">
            <div class="col">
                <div class="card h-100 border-0 bg-transparent">
                    <div class="card-body">
                        <h5 class="card-title">Livraison rapide</h5>
                        <p class="card-text">Vos commandes expédiées sous 24h.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 bg-transparent">
                    <div class="card-body">
                        <h5 class="card-title">Paiement sécurisé</h5>
                        <p class="card-text">Transactions protégées de bout en bout.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 bg-transparent">
                    <div class="card-body">
                        <h5 class="card-title">Support réactif</h5>
                        <p class="card-text">Une équipe disponible 7j/7.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
