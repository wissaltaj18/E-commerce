{# templates/product/products.html.twig #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - Our Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<!-- Header -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('products') }}">Our Store</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link active" href="{{ path('products') }}">Products</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('cart') }}">Cart</a>
                </li>

                {# ✅ Bloc login/logout #}
                <li class="nav-item ms-3">
                    {% if app.user %}
                        <span class="text-success me-2">
                            Bienvenue {{ app.user.name }}
                        </span>
                        <a href="{{ path('app_logout') }}" class="btn btn-danger btn-sm">
                            Logout
                        </a>
                    {% else %}
                        <a href="{{ path('app_auth') }}" class="btn btn-primary btn-sm">
                            Login
                        </a>
                    {% endif %}
                </li>

            </ul>
        </div>
    </div>
</nav>

<!-- Products Section -->
<div class="container my-5">
    <h1 class="mb-4">Our Products</h1>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for product in products %}
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('item.png') }}" class="card-img-top" alt="Produit">
                    <div class="card-body">
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text fw-bold text-success">${{ product.price }}</p>
                        <a href="{{ path('product_details', {'id': product.id}) }}" class="btn btn-outline-primary">View Details</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>No products found.</p>
        {% endfor %}
    </div>
</div>

<!-- Footer -->
<footer class="bg-dark text-white mt-5 py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h5>Our Store</h5>
                <p>Quality products at affordable prices</p>
            </div>
            <div class="col-md-6 text-md-end">
                <p>&copy; 2026 Our Store. All rights reserved.</p>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>