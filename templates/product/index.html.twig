{% extends 'base.html.twig' %}

{% block title %}Produits - Notre Boutique{% endblock %}

{% block nav_products %}active{% endblock %}

{% block body %}
<main class="container my-5">
    {# En-tête de la page #}
    <header class="mb-4">
        <h1 class="fw-bold text-dark">Nos Produits</h1>
        <p class="lead text-primary">Bienvenue dans notre boutique !</p>
        <p class="text-muted">Découvrez notre sélection de produits de qualité.</p>
    </header>

    {# Formulaire de recherche et de filtrage #}
    <form action="{{ path('products') }}" method="get" class="row g-3 mb-5 align-items-center" role="search" aria-label="Rechercher et filtrer les produits">
        <div class="col-md flex-grow-1">
            <label for="search-query" class="visually-hidden">Rechercher un produit</label>
            <div class="input-group shadow-sm rounded-3">
                <span class="input-group-text bg-white text-muted border-end-0" id="search-addon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </span>
                <input type="search" 
                       id="search-query" 
                       name="q" 
                       value="{{ searchQuery|default('') }}"
                       class="form-control border-start-0 ps-0" 
                       placeholder="Rechercher un produit..."
                       aria-describedby="search-addon">
            </div>
        </div>

        <div class="col-md-auto">
            <label for="search-category" class="visually-hidden">Catégorie</label>
            <select id="search-category" name="category" class="form-select shadow-sm rounded-3">
                <option value="">Toutes les catégories</option>
                {% for category in categories|default([]) %}
                    <option value="{{ category.id }}" {% if selectedCategory|default('') == category.id %}selected{% endif %}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary px-4 shadow-sm rounded-3">
                Rechercher
            </button>
        </div>

        {% if searchQuery|default('') is not empty or selectedCategory|default('') is not empty %}
            <div class="col-auto">
                <a href="{{ path('products') }}" class="btn btn-outline-secondary rounded-3" title="Réinitialiser les filtres">
                    Réinitialiser
                </a>
            </div>
        {% endif %}
    </form>

    {# Grille des produits #}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        {% for product in products|default([]) %}
            <div class="col">
                <article class="card h-100 shadow-sm border-0 rounded-3 transition-all hover-shadow">
                    <div class="position-relative overflow-hidden bg-light rounded-top-3">
                        <img src="{{ product.image ? asset(product.image) : asset('item.png') }}"
                             class="card-img-top" 
                             alt="{{ product.name }}"
                             style="height: 220px; object-fit: cover;"
                             loading="lazy"
                             decoding="async">
                        
                        {% if product.category is defined and product.category is not null %}
                            <span class="badge bg-secondary position-absolute top-0 start-0 m-3 shadow-sm">
                                {{ product.category.name }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title text-dark mb-2">{{ product.name }}</h2>
                        <p class="card-text text-muted small flex-grow-1">
                            {{ product.description|default('')|striptags|u.truncate(120, '...') }}
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <span class="fw-bold text-success fs-5">
                                {{ product.price|default(0)|number_format(2, ',', ' ') }} <small class="fs-6 fw-normal text-muted">MAD</small>
                            </span>
                            <a href="{{ path('product_details', { id: product.id }) }}"
                               class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                Voir les détails
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center my-5 py-5 rounded-3 shadow-sm border-0" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-info-circle mb-3 text-info" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                    <p class="mb-0 fs-5 fw-medium">Aucun produit ne correspond à votre recherche.</p>
                    {% if searchQuery|default('') is not empty or selectedCategory|default('') is not empty %}
                        <a href="{{ path('products') }}" class="btn btn-primary mt-3 rounded-pill px-4">Effacer les filtres</a>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</main>

{# Section Avantages #}
<section class="bg-light py-5 mt-5 border-top" aria-label="Nos avantages">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Pourquoi nous choisir ?</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 text-center">
            <div class="col">
                <div class="card h-100 border-0 bg-transparent">
                    <div class="card-body">
                        <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 3.5rem; height: 3.5rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-truck" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-4 0H1.5A1.5 1.5 0 0 1 0 10.5v-7zm1 1v5a.5.5 0 0 0 .5.5h.08a2 2 0 0 1 3.84 0h5.16a2 2 0 0 1 3.84 0h.58a.5.5 0 0 0 .5-.5V8l-1.48-1.85A.5.5 0 0 0 13.02 6H12v2.5a.5.5 0 0 1-1 0V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5z"/>
                            </svg>
                        </div>
                        <h3 class="h5 card-title fw-semibold">Livraison rapide</h3>
                        <p class="card-text text-muted">Vos commandes expédiées sous 24h.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 bg-transparent">
                    <div class="card-body">
                        <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 3.5rem; height: 3.5rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233.465.465 0 0 0 .56 0 10.73 10.73 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453.718.718 0 0 1-.856 0A11.763 11.763 0 0 1 4.053 12.68c-1.678-2.195-3.061-5.513-2.465-9.99A1.54 1.54 0 0 1 2.632 1.43c.658-.215 1.777-.57 2.887-.87z"/>
                                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                            </svg>
                        </div>
                        <h3 class="h5 card-title fw-semibold">Paiement sécurisé</h3>
                        <p class="card-text text-muted">Transactions protégées de bout en bout.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 bg-transparent">
                    <div class="card-body">
                        <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 3.5rem; height: 3.5rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-headset" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866-.5l-1-1.732a1 1 0 0 1 .866-1.5H11.5A1.5 1.5 0 0 1 13 12V6a5 5 0 0 0-5-5z"/>
                            </svg>
                        </div>
                        <h3 class="h5 card-title fw-semibold">Support réactif</h3>
                        <p class="card-text text-muted">Une équipe disponible 7j/7.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}